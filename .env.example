# Canonical site origin (SEO: metadataBase, sitemap, robots, Open Graph)
# Production’da zorunlu — boşsa OG paylaşım kartları localhost’a düşer / çalışmaz.
# Örnek: https://example.com
NEXT_PUBLIC_SITE_URL=

# Yandex.Metrika counter id (tarayıcıya gider)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Okuyucu profili (public.users) senkronu — sunucuda zorunlu
SUPABASE_SERVICE_ROLE_KEY=

# Kitap sohbeti (RAG) — scripts/index-books.mjs ve /api/chat
OPENAI_API_KEY=

# Parçalı vektör indeksi — scripts/build-vector-index-batches.mjs (psql URI)
# Supabase → Project Settings → Database → Session pooler (5432)
DATABASE_URL=

R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=

ZONE_TOKEN=
ZONE_ID=
# Contact form (SMTP / nodemailer — sunucu tarafı)
# Yahoo: MAIL_FROM = SMTP_USER; SMTP_PASS = uygulama şifresi (hesap şifresi değil).
# Yahoo ile Reply-To farklı domain (Gmail) 550 hatası verir — varsayılan kapalı; yanıt adresi mail gövdesinde.
# SMTP_ALLOW_REPLY_TO=true  # yalnızca Gmail/Outlook SMTP kullanıyorsanız açın
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_MAIL_TO=
